{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xixi-haha-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-24",
  "vars": {
    "BOT_USERNAME": "xixi_haha_bot"
  },
  "assets": {
    "directory": "./generated-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
