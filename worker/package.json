{
  "name": "xixi-haha-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "fixtures": "python3 scripts/generate-test-assets.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "node scripts/runtime-test.mjs",
    "test:runtime:deployment": "WRANGLER_CONFIG=wrangler.deploy.jsonc node scripts/runtime-test.mjs",
    "package:dry-run": "wrangler deploy --dry-run --outdir dist",
    "package:deployment": "wrangler deploy --config wrangler.deploy.jsonc --dry-run --outdir dist-deployment"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@types/node": "22.18.6",
    "typescript": "5.9.2",
    "vitest": "5.0.3",
    "wrangler": "4.145.0"
  }
}
